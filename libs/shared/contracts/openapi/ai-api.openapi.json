{
  "components": {
    "schemas": {
      "LivenessResponse": {
        "description": "The process is up.",
        "properties": {
          "status": {
            "const": "ok",
            "title": "Status",
            "type": "string"
          }
        },
        "required": ["status"],
        "title": "LivenessResponse",
        "type": "object"
      },
      "ReadinessResponse": {
        "description": "Whether the service can take traffic; `checks` lists failed dependencies.",
        "properties": {
          "checks": {
            "anyOf": [
              {
                "additionalProperties": {
                  "const": "error",
                  "type": "string"
                },
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "description": "Present when not ready, e.g. {'database': 'error'}.",
            "title": "Checks"
          },
          "status": {
            "enum": ["ready", "unavailable"],
            "title": "Status",
            "type": "string"
          }
        },
        "required": ["status"],
        "title": "ReadinessResponse",
        "type": "object"
      },
      "ServiceInfo": {
        "description": "Service name, version and environment.",
        "properties": {
          "env": {
            "title": "Env",
            "type": "string"
          },
          "service": {
            "title": "Service",
            "type": "string"
          },
          "version": {
            "title": "Version",
            "type": "string"
          }
        },
        "required": ["service", "version", "env"],
        "title": "ServiceInfo",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "docQA AI service (internal)",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/healthz": {
      "get": {
        "description": "Liveness probe.",
        "operationId": "healthz_healthz_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LivenessResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Liveness probe",
        "tags": ["health"]
      }
    },
    "/readyz": {
      "get": {
        "description": "Readiness probe: 200 if the database answers, else 503.",
        "operationId": "readyz_readyz_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadinessResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadinessResponse"
                }
              }
            },
            "description": "A dependency is down"
          }
        },
        "summary": "Readiness probe",
        "tags": ["health"]
      }
    },
    "/v1/info": {
      "get": {
        "description": "Return service name, version and environment.",
        "operationId": "info_v1_info_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ServiceInfo"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Service info",
        "tags": ["v1"]
      }
    }
  }
}
