# Copy to .env for local development:
#   PowerShell:  Copy-Item .env.example .env
#   bash/make:   cp .env.example .env
#
# Settings are read by docqa_core.config.Settings (env prefix DOCQA_).
# These values target services running on localhost (started by `docker compose up -d`).
# Containerised ai-api/worker services override the hosts in docker-compose.yml.

# --- Environment -------------------------------------------------------------
# One of: local, dev, staging, prod
DOCQA_ENV=local
DOCQA_SERVICE_NAME=docqa
DOCQA_LOG_LEVEL=INFO
# true = JSON logs (production style); false = human-readable console logs
DOCQA_LOG_JSON=true

# --- Postgres (app database; also used by Alembic) ---------------------------
DOCQA_DATABASE_URL=postgresql+psycopg://docqa:docqa@localhost:5432/docqa

# --- Redis -------------------------------------------------------------------
DOCQA_REDIS_URL=redis://localhost:6379/0

# --- Qdrant (vector index) ---------------------------------------------------
DOCQA_QDRANT_URL=http://localhost:6333

# --- Object storage (MinIO locally, S3-compatible in other environments) -----
DOCQA_S3_ENDPOINT_URL=http://localhost:9000
DOCQA_S3_ACCESS_KEY=minioadmin
DOCQA_S3_SECRET_KEY=minioadmin
DOCQA_S3_BUCKET_RAW=docqa-raw

# --- Temporal (ingestion workflows) ------------------------------------------
DOCQA_TEMPORAL_ADDRESS=localhost:7233
DOCQA_TEMPORAL_NAMESPACE=default
DOCQA_TEMPORAL_TASK_QUEUE=ingestion

# --- OpenTelemetry tracing (Grafana LGTM) ------------------------------------
# Set to true to export traces to otel-lgtm (Grafana at http://localhost:3000)
DOCQA_OTEL_ENABLED=false
DOCQA_OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# --- LLM provider ------------------------------------------------------------
# Not used until M1 (answer generation). Leave empty for now.
ANTHROPIC_API_KEY=
